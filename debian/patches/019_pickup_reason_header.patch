+static void rfc3326_add_answered_elsewhere_header(struct ast_sip_session *session, struct pjsip_tx_data *tdata)
+{
+	char reason[256];
+	char endpoint[AST_MAX_EXTENSION];
+	const char *picker;
+	char *dash;
+
+	ast_channel_lock(session->channel);
+	picker = pbx_builtin_getvar_helper(session->channel, "PICKEDUPBY");
+	ast_copy_string(endpoint, S_OR(picker, ""), sizeof(endpoint));
+	ast_channel_unlock(session->channel);
+
+	/* PJSIP/<endpoint>-<sequence> */
+	if (strncmp(endpoint, "PJSIP/", 6) || !(dash = strrchr(endpoint, '-'))) {
+		ast_sip_add_header(tdata, "Reason", "SIP;cause=200;text=\"Call completed elsewhere\"");
+		return;
+	}
+	*dash = '\0';
+
+	/* Endpoint ids may not be SIP tokens: always send it quoted */
+	snprintf(reason, sizeof(reason),
+		"SIP;cause=200;text=\"Call completed elsewhere\";pickedup-by=\"%s\"", endpoint + 6);
+	ast_sip_add_header(tdata, "Reason", reason);
+}
