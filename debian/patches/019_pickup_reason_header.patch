Report the endpoint that picked up a call in the CANCEL sent to the ringing
channel, as a pickedup-by parameter of the "Call completed elsewhere" Reason.

--- a/main/pickup.c
+++ b/main/pickup.c
@@ -376,6 +376,10 @@
 		goto pickup_failed;
 	}
 
+	/* chan now holds the ringing channel: tell it who picked it up, so the
+	 * channel driver can report it when cancelling the call */
+	pbx_builtin_setvar_helper(chan, "PICKEDUPBY", chan_name);
+
 	/* target points to the channel that did the pickup at this point, so use that channel's topic instead of chan */
 	send_call_pickup_stasis_message(target, chan_snapshot, target_snapshot);
 
